BINDEROS_GATEWAY_TOKEN=replace-with-a-long-random-token
BINDEROS_JOB_ROOT=/var/lib/binderos/jobs
ALPHAFOLD3_SCRIPT=/opt/alphafold3/run_alphafold.py
ALPHAFOLD3_MODEL_DIR=/opt/alphafold3/models
ALPHAFOLD3_DB_DIR=/opt/alphafold3/databases
DEEPTMHMM_BIN=dtm2
DEEPTMHMM_DEVICE=cuda
BINDCRAFT_SCRIPT=/opt/BindCraft/bindcraft.py
BINDCRAFT_PYTHON=/opt/BindCraft/conda/bin/python
BINDCRAFT_SETTINGS=/opt/BindCraft/settings_target/default.json
BINDCRAFT_FILTERS=/opt/BindCraft/settings_filters/default_filters.json
BINDCRAFT_ADVANCED=/opt/BindCraft/settings_advanced/default_4stage_multimer.json
